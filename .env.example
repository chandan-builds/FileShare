# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=fileshare-production
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Application — keep R2_FREE_TIER_STORAGE_GB at or below 9 so usage stays inside R2's 10 GB included storage
MAX_FILE_SIZE_MB=2048
R2_FREE_TIER_STORAGE_GB=9
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional extra CORS origins, comma-separated. Do not use *.
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
